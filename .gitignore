# ─── Generated data ───────────────────────────────────────────────────────────
# Everything under data/ is produced by the pipeline and regenerable. Only the
# README and the shortlist template are tracked (see negations at the end).
data/*

# The CARE deep-dive keeps its working data alongside its deliverables so the
# workstream is self-contained. It is still generated data — never commit it.
# (~66M: corpus, extraction cards, evidence DB, digests, synthesis sections.)
CARE_review/data/

# ─── Separate project ─────────────────────────────────────────────────────────
# TRACE is its own project; it lives in a sibling repo, not here.
trace/

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.env

# ─── R ────────────────────────────────────────────────────────────────────────
.Rhistory
.RData
.Rproj.user

# ─── Harness / editor ─────────────────────────────────────────────────────────
.claude/scheduled_tasks.lock

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log

# ─── CEGA brand source assets ─────────────────────────────────────────────────
# Logos are embedded (base64) in the slide deck, so heavy source binaries are
# not needed in-repo.
CEGA Logos/*.mov
CEGA Logos/*.ai
CEGA Logos/EPS/

# ─── OS ───────────────────────────────────────────────────────────────────────
.DS_Store

# ─── Tracked exceptions (must come last) ──────────────────────────────────────
# Hand-authored files inside data/ that SHOULD be versioned.
!data/README.md
!data/shortlist.template.json
